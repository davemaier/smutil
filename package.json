{
  "name": "ai-hooks",
  "private": true,
  "scripts": {
    "dev": "bun run --filter='*' dev",
    "dev:backend": "bun run --filter='{server,@ai-hooks/core}' dev",
    "release": "semantic-release",
    "build:prd": "bun run --filter='@ai-hooks/*' build:prd",
    "publish": "bun run --filter='@ai-hooks/*' publish",
    "build:clients": "bun run --filter='{@ai-hooks/client-solid,@ai-hooks/client-react}' build:prd",
    "publish:clients": "bun run --filter='{@ai-hooks/client-solid,@ai-hooks/client-react}' publish",
    "deploy:clients": "bun run build:clients && bun run publish:clients"
  },
  "workspaces": [
    "packages/*"
  ],
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@types/bun": "latest",
    "semantic-release": "^24.2.2",
    "semantic-release-monorepo": "^8.0.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "version": "1.0.0-alpha.2"
}
